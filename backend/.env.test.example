# Variáveis dos testes automáticos (seção 4.1 de docs/plano-e-relatorio-de-testes.md).
# Copie para .env.test: Copy-Item .env.test.example .env.test
#
# As chaves abaixo são FICTÍCIAS e públicas: servem só para os testes e nunca podem ser
# usadas em desenvolvimento ou produção (seção 2 de docs/seguranca-e-nuvem.md).

NODE_ENV=test
PORT=3001
TZ=America/Sao_Paulo

# Banco de teste do Docker (criado por docker/init.sql). Os testes APAGAM todas as tabelas
# dele a cada execução; por isso só rodam num banco cujo nome contenha "test".
DATABASE_URL="postgresql://fhdod:fhdod@localhost:5433/fhdod_teste"
DIRECT_URL="postgresql://fhdod:fhdod@localhost:5433/fhdod_teste"

JWT_SEGREDO=xr+9/VxPFX0daCaMq6uAfRbAmp8WA180QnDvMf4lKFE=
JWT_EXPIRACAO=8h

FRONTEND_URL=http://localhost:5173

TELEFONE_CHAVE_VERSAO=v1
