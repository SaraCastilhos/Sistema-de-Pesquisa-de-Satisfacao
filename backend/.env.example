# Modelo das variáveis de ambiente (seção 2 de docs/seguranca-e-nuvem.md).
# Copie para .env e preencha. O .env nunca vai para o Git.

# Ambiente
NODE_ENV=development
PORT=3000
TZ=America/Sao_Paulo

# Banco de dados
# Em desenvolvimento: o PostgreSQL local do Docker (as duas variáveis iguais).
# No Neon: DATABASE_URL usa o endereço com -pooler (usado pela API)
# e DIRECT_URL o endereço direto (usado só pelas migrações do Prisma).
DATABASE_URL="postgresql://fhdod:fhdod@localhost:5433/fhdod"
DIRECT_URL="postgresql://fhdod:fhdod@localhost:5433/fhdod"

# Autenticação
JWT_SEGREDO=gerar-com-o-comando-abaixo
JWT_EXPIRACAO=8h

# Origem permitida pelo CORS (endereço do frontend, sem barra no final)
FRONTEND_URL=http://localhost:5173

# Criptografia do telefone (32 bytes em base64 cada)
TELEFONE_CHAVE_VERSAO=v1
TELEFONE_CHAVE_CIFRA=gerar-com-o-comando-abaixo
TELEFONE_CHAVE_HMAC=gerar-com-o-comando-abaixo

# Povoamento inicial
SEED_SUPER_ADMIN_EMAIL=ouvidoria@exemplo.com
SEED_SUPER_ADMIN_SENHA=trocar-no-primeiro-acesso
SEED_DEMONSTRACAO=false

# Registro de requisições
LOG_NIVEL=info

# Para gerar cada segredo e cada chave (um valor diferente para cada uma):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
