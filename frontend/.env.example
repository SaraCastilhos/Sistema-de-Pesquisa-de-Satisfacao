# Tudo que começa com VITE_ é público: fica visível no navegador. Nunca coloque chaves aqui.

# Endereço da API (backend). Em desenvolvimento, o npm run dev do backend sobe na porta 3000.
# Na Vercel: o endereço do Render (https://NOME.onrender.com), sem barra no final.
VITE_API_URL=http://localhost:3000

# true = usa os dados simulados de src/api/simulado/ (para trabalhar sem o backend rodando).
# Na Vercel: false (ou sem a variável).
VITE_API_SIMULADA=false
